NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server only. Prefer the current Supabase sb_secret key; the legacy service-role variable is also supported.
SUPABASE_SECRET_KEY=sb_secret_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TRUSHOT_WORKSPACE_ID=11111111-1111-4111-8111-111111111111
TABLET_REFRESH_INTERVAL_MINUTES=15
NOTION_API_TOKEN=
# Optional: leave blank while no Clients database exists.
NOTION_CLIENTS_DATA_SOURCE_ID=
NOTION_JOBS_DATA_SOURCE_ID=47b8cec5c99a4975a2d6ff1e990eb2b1
NOTION_TASKS_DATA_SOURCE_ID=b5cdeb9c0bcb4c87833bddeeee4ca956
NOTION_SYNC_INTERVAL_MINUTES=15
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Native Web Push. Generate a matched public/private VAPID key pair and never expose the private key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@fearlessau.com
